---
// Símbolo do aplicativo: um marcador de mapa com o sol e o Rio do Peixe.
// "invertido": versão clara, para usar sobre as faixas coloridas.
interface Props { tamanho?: number; class?: string; invertido?: boolean }
const { tamanho = 36, class: classe, invertido = false } = Astro.props;
const fundo = invertido ? '#FFFFFF' : '#0F766E';
const pino = invertido ? '#0F766E' : '#FFFBF5';
const rio = invertido ? '#38BDF8' : '#9FD0DC';
---
<svg class={classe} width={tamanho} height={tamanho} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <rect width="48" height="48" rx="13" fill={fundo} />
  <path d="M24 7.500c-5.800 0-10.500 4.600-10.500 10.300 0 6.900 7.400 13.900 9.600 15.800a1.400 1.400 0 0 0 1.800 0c2.200-1.900 9.600-8.900 9.600-15.800C34.500 12.100 29.800 7.500 24 7.500z" fill={pino} />
  <circle cx="24" cy="17.800" r="4.400" fill="#F59E0B" />
  <path d="M8.500 40.500c3.900-2.700 7.300-2.700 10.300 0 3 2.700 6.400 2.700 10.400 0 3.900-2.700 7.300-2.700 10.300 0" fill="none" stroke={rio} stroke-width="2.800" stroke-linecap="round" />
</svg>

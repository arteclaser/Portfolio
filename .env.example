# ---------------------------------------------------------------
# Portfólio mostraqui.net — configuração de PRODUÇÃO (modelo)
# Copie para .env e preencha. Nunca publique o .env no repositório.
# ---------------------------------------------------------------
APP_NAME="Portfólio"
APP_ENV=production
# Gere com: php artisan key:generate (ou localmente: php artisan key:generate --show)
APP_KEY=
APP_DEBUG=false
APP_URL=https://mostraqui.net
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Banco MySQL/MariaDB criado no cPanel (Bancos de dados MySQL).
# No cPanel, nome do banco e usuário recebem o prefixo da conta (ex.: conta_portfolio).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sessões e cache em arquivos (funcionam em hospedagem compartilhada).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Com HTTPS ativo, mantenha true.
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# E-mail (convites e recuperação de senha). Use uma conta criada no cPanel,
# por exemplo nao-responda@mostraqui.net. Com MAIL_MAILER=log, nada é enviado e o
# painel mostra o link de convite para o Master copiar.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.mostraqui.net
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responda@mostraqui.net"
MAIL_FROM_NAME="${APP_NAME}"

# Vários portfólios. "path": mostraqui.net/capinzal (padrão, sem configuração no cPanel).
# "subdomain": capinzal.mostraqui.net (exige subdomínio "*", DNS curinga e SSL curinga, uma única vez).
# Ver docs/MULTIPORTFOLIO-E-SUBDOMINIOS.md
PORTFOLIO_ROUTING=path
PORTFOLIO_BASE_DOMAIN=mostraqui.net
PLATFORM_NAME="Mostraqui"
PLATFORM_TAGLINE="Portfólios institucionais de ações públicas"

# Validade do convite, em minutos (padrão: 72 horas).
INVITE_EXPIRE_MINUTES=4320

# Prévia automática de links (Open Graph / oEmbed). Pode ser desligada.
LINK_PREVIEW_ENABLED=true
# Deixe vazio. Um proxy reduz a proteção contra SSRF, pois ele resolve o DNS.
LINK_PREVIEW_PROXY=

# Instalação pela web (/instalar), só para hospedagem sem terminal.
# Defina um código longo e aleatório, instale e APAGUE esta linha em seguida.
SETUP_TOKEN=
